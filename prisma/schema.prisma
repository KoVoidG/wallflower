datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  business       Business?
  userPreference UserPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserPreference {
  id     String @id @default(uuid())
  theme  String @default("system")
  locale String @default("th")
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

model Business {
  id                 String              @id @default(uuid())
  name               String
  industry           String
  type               String
  stage              String
  size               String
  location           String
  goals              String[]
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  financialSnapshots FinancialSnapshot[]
  riskAssessments    RiskAssessment[]
  simulations        Simulation[]
  reports            Report[]

  @@map("business")
}

model FinancialSnapshot {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month             DateTime
  revenue           Decimal          @db.Decimal(12, 2)
  expenseCategories Json
  cashReserve       Decimal          @db.Decimal(12, 2)
  receivables       Decimal          @db.Decimal(12, 2)
  payables          Decimal          @db.Decimal(12, 2)
  debt              Decimal          @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  metricSnapshot    MetricSnapshot?
  riskAssessments   RiskAssessment[]
  simulations       Simulation[]

  @@unique([businessId, month])
  @@index([businessId])
  @@map("financial_snapshot")
}

model MetricSnapshot {
  id                String            @id @default(uuid())
  snapshotId        String            @unique
  financialSnapshot FinancialSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  cashRunway        Decimal?          @db.Decimal(12, 2)
  grossProfit       Decimal           @db.Decimal(12, 2)
  netProfit         Decimal           @db.Decimal(12, 2)
  profitMargin      Decimal           @db.Decimal(5, 2)
  burnRate          Decimal           @db.Decimal(12, 2)
  workingCapital    Decimal           @db.Decimal(12, 2)
  currentRatio      Decimal?          @db.Decimal(8, 2)
  breakEven         Decimal           @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())

  @@map("metric_snapshot")
}

model RiskAssessment {
  id                String            @id @default(uuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshotId        String
  financialSnapshot FinancialSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  detectedRisks     DetectedRisk[]

  @@index([businessId])
  @@index([snapshotId])
  @@map("risk_assessment")
}

model DetectedRisk {
  id             String         @id @default(uuid())
  assessmentId   String
  riskAssessment RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  ruleId         String
  category       String
  severity       String
  probability    String
  impact         String
  evidence       String
  mitigation     String
  status         String         @default("active")

  @@index([assessmentId])
  @@map("detected_risk")
}

model Simulation {
  id                 String             @id @default(uuid())
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baselineSnapshotId String
  baselineSnapshot   FinancialSnapshot  @relation(fields: [baselineSnapshotId], references: [id], onDelete: Restrict)
  scenarioType       String
  name               String
  calculationVersion String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  input              SimulationInput?
  results            SimulationResult[]
  aiRecommendation   AIRecommendation?

  @@index([businessId])
  @@index([baselineSnapshotId])
  @@map("simulation")
}

model SimulationInput {
  id           String     @id @default(uuid())
  simulationId String     @unique
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  assumptions  Json

  @@map("simulation_input")
}

model SimulationResult {
  id             String     @id @default(uuid())
  simulationId   String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  caseType       String
  revenue        Decimal    @db.Decimal(12, 2)
  expenses       Decimal    @db.Decimal(12, 2)
  profit         Decimal    @db.Decimal(12, 2)
  cashRunway     Decimal?   @db.Decimal(12, 2)
  workingCapital Decimal    @db.Decimal(12, 2)
  roi            Decimal?   @db.Decimal(5, 2)
  paybackPeriod  Decimal?   @db.Decimal(8, 2)

  @@index([simulationId])
  @@map("simulation_result")
}

model AIRecommendation {
  id              String     @id @default(uuid())
  simulationId    String     @unique
  simulation      Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  summary         String
  recommendation  String
  confidenceLabel String
  evidence        Json
  risks           String[]
  actions         Json
  assumptions     String[]
  uncertainty     String
  disclaimer      String
  createdAt       DateTime   @default(now())

  @@map("ai_recommendation")
}

model Report {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  dataThroughDate    DateTime
  calculationVersion String
  summary            String
  healthAnalysis     Json
  risks              Json
  simulationDetails  Json
  recommendations    Json
  actionPlan         Json
  createdAt          DateTime @default(now())

  @@index([businessId])
  @@map("report")
}
