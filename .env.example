# ============================================================
# Database Configuration
# ============================================================
# Neon PostgreSQL pooled connection string (used for application queries)
DATABASE_URL="postgresql://user:password@ep-host-pool.region.aws.neon.tech/dbname?sslmode=require"

# Neon PostgreSQL direct connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-host-direct.region.aws.neon.tech/dbname?sslmode=require"

# ============================================================
# Better Auth Configuration
# ============================================================
# Secret key used for signing session tokens (run `npx better-auth secret` to generate)
BETTER_AUTH_SECRET="your-better-auth-secret-key"

# Base URL of the application (must match the deployment host)
BETTER_AUTH_URL="http://localhost:3000"

# ============================================================
# OAuth Providers
# ============================================================
# Google OAuth configuration for user sign-in
GOOGLE_CLIENT_ID="google-client-id-here"
GOOGLE_CLIENT_SECRET="google-client-secret-here"

# ============================================================
# AI Integration
# ============================================================
# Google Gemini API key (used for explanation and advice services)
GEMINI_API_KEY="google-gemini-api-key-here"

# ============================================================
# Application Config
# ============================================================
# Next.js public deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Development Auth Bypass
# ============================================================
# Set to "true" to bypass authentication in development mode.
# This provides a mock user/session so all protected pages are accessible.
# NEVER set this in production — it only works when NODE_ENV=development.
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
